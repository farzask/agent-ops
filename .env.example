# AgentOps configuration.
# Copy to `.env` and adjust. `.env` is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# Datastores
# ---------------------------------------------------------------------------
# Must use the `postgresql+asyncpg://` scheme. A bare `postgresql://` picks the
# sync psycopg driver and fails at runtime.
# Host `postgres` / `redis` are the Docker Compose service names. Use
# `localhost` when running the backend outside Compose.
DATABASE_URL=postgresql+asyncpg://agentops:agentops@postgres:5432/agentops
REDIS_URL=redis://redis:6379/0

# Credentials Compose uses to initialize the Postgres container. Keep these in
# sync with DATABASE_URL above.
POSTGRES_USER=agentops
POSTGRES_PASSWORD=agentops
POSTGRES_DB=agentops

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# `mock` is the only provider implemented today (a deliberate choice - it runs
# the full orchestrator, retry, and failure paths at zero API cost).
LLM_PROVIDER=mock
LLM_MODEL=mock-small
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30

# Mock-provider behaviour, used to demo retry/failure handling (PRD 7.6).
# Probability in [0.0, 1.0] that a mock call raises a transient error.
MOCK_FAILURE_RATE=0.0
# Probability that the mock returns unparseable JSON.
MOCK_MALFORMED_RATE=0.0
# Simulated per-call latency in milliseconds.
MOCK_LATENCY_MS=350
# Fixed seed for reproducible mock runs. Leave blank for nondeterministic.
MOCK_SEED=

# ---------------------------------------------------------------------------
# Orchestrator policy (TECH_SPEC 3.2)
# ---------------------------------------------------------------------------
# Technical retry attempts per agent, with exponential backoff 1s / 3s / 9s.
MAX_RETRIES=3
BACKOFF_BASE_SECONDS=1.0
BACKOFF_MULTIPLIER=3.0
# Verifier rejections are counted separately from technical failures.
MAX_REWORK_CYCLES=2

# ---------------------------------------------------------------------------
# Backend server
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# Comma-separated browser origins allowed to call the API and open WebSockets.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Server-side only (Server Components). Docker service name inside Compose.
BACKEND_INTERNAL_URL=http://backend:8000
# Browser-visible. NEXT_PUBLIC_* values are embedded in the client bundle -
# never put a secret here.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
